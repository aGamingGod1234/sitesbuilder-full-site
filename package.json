{
  "name": "sitesbuilder-immersive-hero-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1",
    "serve:test": "astro preview --host 127.0.0.1 --port 4321",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:no-js": "playwright test --project=no-js",
    "qa:phase0": "node scripts/qa/run-phase0.mjs",
    "qa:placeholders": "node scripts/qa/placeholder-scan.mjs",
    "qa:release-summary": "node scripts/qa/release-summary.mjs",
    "capture:proof": "node scripts/qa/capture-proof.mjs",
    "benchmark:lighthouse": "node scripts/qa/run-lighthouse.mjs",
    "benchmark:journey": "playwright test tests/e2e/journey.spec.ts --project=desktop",
    "benchmark:trace-summary": "node scripts/qa/trace-summary.mjs",
    "benchmark:bundle": "node scripts/qa/bundle-budget.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.0.6",
    "gsap": "^3.13.0",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.0",
    "sharp": "0.35.3"
  }
}
