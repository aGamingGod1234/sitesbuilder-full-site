---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routeMeta, packages, sectionAssets } from '../data/site';
const meta = routeMeta.pricing;
---
<BaseLayout title={meta.title} description={meta.description} canonicalPath={meta.path}>
  <section class="scene route-hero compact-hero">
    <img class="scene-bg" src={sectionAssets.pricing} alt="" loading="eager" decoding="async" />
    <div class="section-inner route-hero-inner">
      <p class="microcopy">Pricing</p>
      <h1>Clear packages after the preview.</h1>
      <p>The first step stays free: a preview of the first two sections before a paid build starts.</p>
    </div>
  </section>
  <section class="scene section-scene pricing-scene">
    <img class="scene-bg" src={sectionAssets.conversionAlt} alt="" loading="lazy" decoding="async" />
    <div class="section-inner pricing-deck route-pricing">
      {packages.map((pkg) => (
        <a class="price-card large" href={pkg.href}>
          <span>{pkg.name}</span>
          <strong>{pkg.price}</strong>
          <p>{pkg.body}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
