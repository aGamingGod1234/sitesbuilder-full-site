---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routeMeta, processSteps, sectionAssets } from '../data/site';
const meta = routeMeta.process;
---
<BaseLayout title={meta.title} description={meta.description} canonicalPath={meta.path}>
  <section class="scene route-hero compact-hero">
    <img class="scene-bg" src={sectionAssets.process} alt="" loading="eager" decoding="async" />
    <div class="section-inner route-hero-inner">
      <p class="microcopy">Process</p>
      <h1>First two sections, then the full build.</h1>
      <p>The process is designed to reduce risk for local businesses before they sign.</p>
    </div>
  </section>
  <section class="scene section-scene process-strip tall-process">
    <img class="scene-bg" src={sectionAssets.processAlt} alt="" loading="lazy" decoding="async" />
    <div class="section-inner process-lane">
      {processSteps.map(([label, body]) => (
        <article class="process-node big-node">
          <span>{label}</span>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
