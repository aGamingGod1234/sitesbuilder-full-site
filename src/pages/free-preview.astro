---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routeMeta, sectionAssets, whatsappHref, mailHref } from '../data/site';
const meta = routeMeta.preview;
---
<BaseLayout title={meta.title} description={meta.description} canonicalPath={meta.path}>
  <section class="scene route-hero contact-hero">
    <img class="scene-bg" src={sectionAssets.conversion} alt="" loading="eager" decoding="async" />
    <div class="final-card contact-card">
      <p class="microcopy">Free preview request</p>
      <h1>Get the hero and first proof section drafted first.</h1>
      <p>Send the business name, current link, and the action customers should take. The full website starts only after you approve the direction.</p>
      <div class="hero-actions center-actions">
        <a class="button-primary" href={whatsappHref} target="_blank" rel="noopener">Send on WhatsApp</a>
        <a class="button-secondary" href={mailHref}>Email the brief</a>
      </div>
    </div>
  </section>
</BaseLayout>
