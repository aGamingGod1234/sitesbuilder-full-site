---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routeMeta, proofTiles, sectionAssets } from '../data/site';
const meta = routeMeta.work;
---
<BaseLayout title={meta.title} description={meta.description} canonicalPath={meta.path}>
  <section class="scene route-hero compact-hero">
    <img class="scene-bg" src={sectionAssets.proofAlt} alt="" loading="eager" decoding="async" />
    <div class="section-inner route-hero-inner">
      <p class="microcopy">Work proof</p>
      <h1>Proof tiles should open real sites.</h1>
      <p>These examples are deliberately framed as live hero sections, not long fake case-study panels.</p>
    </div>
  </section>
  <section class="scene section-scene work-gallery">
    <img class="scene-bg" src={sectionAssets.proof} alt="" loading="lazy" decoding="async" />
    <div class="section-inner live-proof-grid wide-proof-grid">
      {proofTiles.filter((tile) => tile.link.startsWith('http')).map((tile) => (
        <a class="live-proof-card large" href={tile.link} target="_blank" rel="noopener">
          <img src={tile.image} alt={`${tile.label} live hero screenshot`} loading="lazy" decoding="async" />
          <span>{tile.label}</span>
          <strong>{tile.title}</strong>
          <p>{tile.body}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
