---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routeMeta, sectionAssets, whatsappHref, mailHref } from '../data/site';
const meta = routeMeta.contact;
---
<BaseLayout title={meta.title} description={meta.description} canonicalPath={meta.path}>
  <section class="scene route-hero contact-hero">
    <img class="scene-bg" src={sectionAssets.contact} alt="" loading="eager" decoding="async" />
    <div class="final-card contact-card">
      <p class="microcopy">Contact</p>
      <h1>Send the business. We draft the opening.</h1>
      <p>Use WhatsApp for the fastest preview request, or email the business details.</p>
      <div class="hero-actions center-actions">
        <a class="button-primary" href={whatsappHref} target="_blank" rel="noopener">WhatsApp Local Web Works</a>
        <a class="button-secondary" href={mailHref}>Email the brief</a>
      </div>
    </div>
  </section>
</BaseLayout>
