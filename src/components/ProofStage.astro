---
import { proofTiles, sectionAssets } from '../data/site';
---
<div class="hero-stage" data-proof-stage>
  <img class="stage-bg" src={sectionAssets.heroAlt} alt="" loading="eager" decoding="async" />
  <div class="stage-shell">
    <div class="stage-topline">
      <span>Proof viewport</span>
      <small>Swipe or tab through live proof</small>
    </div>
    <div class="tile-deck" aria-label="SitesBuilder proof tiles">
      {proofTiles.map((tile, index) => (
        <article class={`proof-tile tile-${tile.id}`} data-proof-tile={tile.id} tabindex={index === 1 ? 0 : -1} style={`--tile-accent:${tile.accent}`}>
          <a href={tile.link} target={tile.link.startsWith('http') ? '_blank' : undefined} rel={tile.link.startsWith('http') ? 'noopener' : undefined} aria-label={`${tile.title}: ${tile.label}`}>
            <img src={tile.image} alt="" loading={index === 1 ? 'eager' : 'lazy'} decoding="async" />
            <div class="tile-glass">
              <span>{tile.label}</span>
              <h3>{tile.title}</h3>
              <p>{tile.body}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="stage-controls" aria-label="Mobile proof controls">
      <button class="step-control" type="button" data-step-prev>Previous</button>
      <button class="step-control" type="button" data-step-next>Next</button>
    </div>
  </div>
</div>
