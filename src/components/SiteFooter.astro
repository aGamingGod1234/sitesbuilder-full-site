---
import { navItems, whatsappHref, mailHref } from '../data/site';
---
<footer class="footer">
  <div class="footer-inner">
    <a class="footer-brand" href="/">
      <strong>SitesBuilder</strong>
      <span>by Local Web Works</span>
    </a>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/">Home</a>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/free-preview/">Free preview</a>
      <a href={whatsappHref} target="_blank" rel="noopener">WhatsApp</a>
      <a href={mailHref}>Email</a>
    </nav>
    <span class="footer-contact">contact@sitesbuilder.store / +65 91616337</span>
  </div>
</footer>
